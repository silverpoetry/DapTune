{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/silverpoetry/DapTune/main/docs/schema/daptune-profile-v2.schema.json",
  "title": "DapTune profile v2",
  "description": "Lossless 20-band signed Int Q4 gains, independent of application gain-limit settings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "name", "band_plan", "frequencies_hz", "gains_q4"],
  "properties": {
    "format": { "const": "com.weich.daptune.profile" },
    "version": { "const": 2 },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$",
      "x-daptune-max-utf16-code-units": 40
    },
    "band_plan": { "const": "dolby-dap-20-v1" },
    "frequencies_hz": {
      "const": [47, 141, 234, 328, 469, 656, 844, 1031, 1313, 1688, 2250, 3000, 3750, 4688, 5813, 7125, 9000, 11250, 13875, 19688]
    },
    "gains_q4": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      },
      "description": "dB = Q4 / 16. Valid file values do not imply that the vendor DSP accepts the same range."
    }
  }
}
